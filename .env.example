# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- AI provider -----------------------------------------------------------
# none              : no AI calls. `oagbench run` writes FAKE results (clearly labelled)
#                     so the harness, scoring and dashboard work offline. Default for development.
# anthropic         : Claude via the Anthropic API.
# openai_compatible : any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio, ...).
AI_PROVIDER=none

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (Claude API only). Set false on Bedrock/Vertex/Foundry gateways.
ANTHROPIC_FALLBACKS=true

# openai_compatible (example: local Ollama)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: a different model for the LLM judge (same provider). Empty = same model.
JUDGE_MODEL=

# --- Stores ------------------------------------------------------------------
# memory   : in-process vector index and graph (no Docker needed). Text-to-Cypher is unavailable,
#            so the graph pipeline uses entity-anchored neighbourhood expansion only.
# services : Qdrant + Neo4j from docker-compose.yml.
STORE_BACKEND=memory
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_ORACLE_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
# Read-only user for LLM-generated Cypher. Empty = reuse NEO4J_USER (enforce read-only in code only).
NEO4J_READONLY_USER=
NEO4J_READONLY_PASSWORD=

# --- Embeddings ----------------------------------------------------------------
# hash                  : deterministic feature hashing, no download (dev only; weak baseline)
# sentence_transformers : local model, needs `uv sync --extra local-embeddings`
EMBEDDER=hash
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Benchmark ----------------------------------------------------------------------
DATA_DIR=data
RESULTS_DIR=results
CONTEXT_TOKEN_BUDGET=6000
RUN_BUDGET_USD=80
LLM_CONCURRENCY=4
